{
  "contract_family": "source-session-handoff",
  "contract_version": "v1.0",
  "profile": "oauth2-authorization-code-pkce-s256-v1",
  "description": "Closed failure and machine-code matrix for source-session-handoff v1.0. automatic-machine retryable is true only for ISSUER_UNAVAILABLE and DEPENDENCY_UNAVAILABLE. SOURCE_AUTHENTICATION_REQUIRED needs user action and is not automatic-machine retryable. If the client or destination is not trusted, do not redirect the browser to the supplied destination. When a safe registered redirect is already established, browser denial may use only a safe OAuth error and state.",
  "outcomes": [
    {
      "outcome": "malformed",
      "retryable": false,
      "meaning": "The peer object failed structural validation, or a scope element was structurally illegal. Retrying the same bytes cannot succeed."
    },
    {
      "outcome": "unverified",
      "retryable": false,
      "meaning": "Issuer, audience, receiver, client, destination, purpose, or another exact binding did not match, or the source attestation was revoked. Hash equality is not a substitute."
    },
    {
      "outcome": "expired",
      "retryable": false,
      "meaning": "The code window or context lifetime was inverted, non-positive, longer than the profile maximum, elapsed, or past the source session. A new handoff is required."
    },
    {
      "outcome": "replayed",
      "retryable": false,
      "meaning": "The authorization code or handoff was already consumed. Reconciliation must not create a second receiver session."
    },
    {
      "outcome": "identity_not_bound",
      "retryable": false,
      "meaning": "Subject, organisation, account, role context, session, or context was missing, browser-authored, forged, or not bound to the issuer attestation. Source authentication required is user action and is not automatic-machine retryable."
    },
    {
      "outcome": "scope_invalid",
      "retryable": false,
      "meaning": "Record scope was an empty set, duplicated, wildcarded, unsorted, prefix-ambiguous, or not an explicit subset of the initiation request."
    },
    {
      "outcome": "permission_denied",
      "retryable": false,
      "meaning": "Source role and permission bounds were treated as receiver access, or the source account is disabled. This contract does not grant that access."
    },
    {
      "outcome": "unsupported_version",
      "retryable": false,
      "meaning": "The contract family, contract version, or profile is not the published v1.0 pair. Fail closed."
    },
    {
      "outcome": "dependency_unavailable",
      "retryable": true,
      "meaning": "The issuer or another required dependency could not be reached. Retry may reconcile the same attempt only. It must not become success, an empty context, an unscoped redirect, or a second receiver session."
    }
  ],
