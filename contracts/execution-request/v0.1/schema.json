{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WembleyAISolutions/weai-contracts/contracts/execution-request/v0.1/schema.json",
  "title": "Execution Request Contract (v0.1)",
  "description": "Public-safe baseline schema for an execution request and its accepted/denied response. Constrains structure, types, and public enums only; internal formats are intentionally not constrained.",
  "type": "object",
  "additionalProperties": true,
  "required": ["contract_family", "contract_version", "request"],
  "properties": {
    "contract_family": { "const": "execution-request" },
    "contract_version": { "const": "v0.1" },
    "example_id": { "type": "string" },
    "description": { "type": "string" },
    "request": {
      "type": "object",
      "additionalProperties": true,
      "required": ["consumer_ref", "request_type"],
      "properties": {
        "consumer_ref": { "type": "string" },
        "request_type": { "const": "execution" },
        "idempotency_key": { "type": "string" },
        "submitted_at": { "type": "string" },
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": true,
      "required": ["outcome"],
      "properties": {
        "outcome": { "type": "string", "enum": ["accepted", "denied"] },
        "result_ref": { "type": "string" },
        "received_at": { "type": "string" }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
