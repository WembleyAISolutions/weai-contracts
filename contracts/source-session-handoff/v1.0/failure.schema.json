        "UNSUPPORTED_PROFILE",
        "UNSUPPORTED_CONTRACT_VERSION",
        "INVALID_PKCE_METHOD",
        "PKCE_MISMATCH",
        "CODE_EXPIRED",
        "CODE_REPLAYED",
        "CODE_UNKNOWN",
        "SOURCE_ACCOUNT_DISABLED",
        "ORGANISATION_MISMATCH",
        "RECORD_SCOPE_INVALID",
        "SOURCE_ROLE_CONTEXT_INVALID",
        "MALFORMED_REQUEST",
        "MALFORMED_REDEMPTION_RESPONSE",
        "MALFORMED_AUTHENTICATED_CONTEXT",
        "ISSUER_MISMATCH",
        "AUDIENCE_MISMATCH",
        "CONTEXT_EXPIRED",
        "ISSUER_UNAVAILABLE",
        "DEPENDENCY_UNAVAILABLE",
        "PURPOSE_MISMATCH",
        "HANDOFF_MISMATCH",
        "TRANSACTION_MISMATCH",
        "CORRELATION_MISMATCH"
      ],
      "description": "Stable machine code. It determines outcome and retryable. It is not a browser query parameter."
    },
    "retryable": {
      "type": "boolean",
      "description": "True only for ISSUER_UNAVAILABLE and DEPENDENCY_UNAVAILABLE. SOURCE_AUTHENTICATION_REQUIRED is false."
    },
    "correlation_ref": {
      "$ref": "https://github.com/WembleyAISolutions/weai-contracts/contracts/source-session-handoff/v1.0/defs.schema.json#/$defs/opaqueRef",
      "description": "Correlation for this failed attempt. Required even when handoff_ref is omitted."
    },
    "handoff_ref": {
      "$ref": "https://github.com/WembleyAISolutions/weai-contracts/contracts/source-session-handoff/v1.0/defs.schema.json#/$defs/opaqueRef",
