      "const": "source-session-handoff"
    },
    "contract_version": {
      "const": "v1.0"
    },
    "profile": {
      "const": "oauth2-authorization-code-pkce-s256-v1",
      "description": "Profile of the handoff attempt that failed."
    },
    "outcome": {
      "enum": [
        "malformed",
        "unverified",
        "expired",
        "replayed",
        "identity_not_bound",
        "scope_invalid",
        "permission_denied",
        "unsupported_version",
        "dependency_unavailable"
      ],
      "description": "Closed high-level outcome vocabulary. No other outcome is valid in v1.0."
    },
    "code": {
      "enum": [
