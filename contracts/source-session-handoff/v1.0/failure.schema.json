    },
    "occurred_at": {
      "$ref": "https://github.com/WembleyAISolutions/weai-contracts/contracts/source-session-handoff/v1.0/defs.schema.json#/$defs/utcTimestamp",
      "description": "Time this failure was recorded. Calendar validity is a conformance requirement and a schema match alone is not conformance."
